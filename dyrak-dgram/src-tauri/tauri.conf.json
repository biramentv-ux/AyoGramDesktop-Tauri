{
  "$schema": "https://schema.tauri.app/com.tauri-2.0",
  "productName": "dyrakDGram",
  "version": "2.0.0",
  " bundler": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png"
    ]
  },
  "mobile": {
    "android": {
      "project_path": "./android",
      "package_name": "com.dyragram.mobile",
      "min_sdk": 21,
      "target_sdk": 35
    },
    "ios": {
      "project_path": "./ios",
      "bundle_id": "com.dyragram.mobile",
      "deployment_target": "12.0"
    }
  },
  "build": {
    "frontend_dist": "../web/dist",
    "devUrl": "http://localhost:3000"
  }
}
