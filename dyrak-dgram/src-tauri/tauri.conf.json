{
  "$schema": "https://schema.tauri.dev/config-2.4",
  "name": "dyrakDGram",
  "description": "Български Telegram клиент с плъгини и разширена функционалност",
  "version": "1.0.0",
  "icon": "icons/icon.png",
  "license": "MIT",
  "author": "dyrakDGram Team",
  "build": {
    "devPath": "../web",
    "distDir": "../web"
  },
  "bundle": {
    "active": true,
    "identifier": "com.dyrakdgram.desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "A custom Telegram fork desktop application with Bulgarian support and advanced plugins.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestamp": true,
      "tspUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "protocols": {
        "name": "dyrakDGram",
        "schemes": ["dyrakdgram"]
      }
    },
    "iOS": {
      "extends": "com.dyrakdgram.desktop",
      "protocols": {
        "name": "dyrakDGram",
        "schemes": ["dyrakdgram"]
      }
    },
    "android": {
      "extends": "com.dyrakdgram.desktop",
      "protocols": {
        "name": "dyrakDGram",
        "schemes": ["dyrakdgram"]
      }
    }
  },
  "features": [],
  "plugins": {
    "mobile": {
      "active": true,
      "iOS": {
        "extends": "com.dyrakdgram.desktop"
      },
      "android": {
        "extends": "com.dyrakdgram.desktop"
      }
    }
  },
  "updater": {
    "active": true,
    "endpoints": {
      "latest": "https://api.github.com/repos/{{user}}/{{repo}}/releases/latest",
      "update": "https://api.github.com/repos/{{user}}/{{repo}}/releases?prerelease=true"
    },
    "api": {
      "baseUrl": "https://dyrak-dgram.github.io/releases/",
      "github": {
        "owner": "dyrak-dgram",
        "repo": "dyrak-dgram",
        "release_template": "{{tag}}"
      }
    }
  }
}
