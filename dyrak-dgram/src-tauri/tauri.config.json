{
  "$schema": "https://schema.tauri.app/config",
  "identifier": "com.dyragram.mobile",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": "icons/32x32.png",
    "sources": [
      "."
    ],
    "resources": [
      "./src-tauri/target/release/bundle",
      "./web"
    ],
    "category": "Social Networking",
    "desktop": {
      "linux": {
        "appstream_version": "1.0"
      }
    }
  },
  "plugins": [
    "dyrak-dgram"
  ],
  "updater": {
    "active": true,
    "pubkey": "your-public-key-here",
    "endpoint": "https://example.com/download"
  },
  "bundle": {
    "windows": {
      "certificateSubject": "dyrakDGram"
    }
  },
  "desktop": {
    "installMode": "normal",
    "installDir": "/opt/dyrak-dgram"
  },
  "mobile": {
    "android": {
      "source": "./android/src/main/java/com/dyragram/mobile",
      "packageName": "com.dyragram.mobile"
    },
    "ios": {
      "source": "./ios",
      "bundleIdentifier": "com.dyragram.mobile"
    }
  },
  "personalDomain": {
    "active": true,
    "domain": "https://yourdomain.com",
    "cdn": "https://cdn.yourdomain.com",
    "api": "https://api.yourdomain.com"
  },
  "plugins": {
    "config": {
      "fake_payment_interceptor": {
        "enabled": true
      },
      "mk_fuck_payments": {
        "enabled": true
      },
      "unlock_stars_content": {
        "enabled": true
      },
      "local_telegram_premium": {
        "enabled": true
      },
      "spotydown": {
        "enabled": true,
        "downloadDirectory": "~/Music/SpotyDown"
      }
    }
  }
}
