{
  "$schema": "https://schema.tauri.app/config",
  "identifier": "com.dyragram.mobile",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png"
    ],
    "resources": [],
    "processData": true,
    "webviewInstallMode": "embed"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "apps": [
    {
      "name": "dyrakDGram Desktop",
      "build": {
        "frontendDist": "../web",
        "devUrl": "http://localhost:3000"
      }
    },
    {
      "name": "dyrakDGram Mobile",
      "platforms": ["android", "ios"],
      "build": {
        "frontendDist": "../web",
        "devUrl": "http://localhost:3000"
      }
    }
  ]
}
