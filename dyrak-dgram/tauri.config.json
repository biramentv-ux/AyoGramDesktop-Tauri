{
  "$schema": "https://schema.tauri.app/config-2.0",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32.png",
      "icons/128.png",
      "icons/256.png",
      "icons/512.png",
      "icons/1024.png"
    ],
    "resources": [
      "src/assets"
    ],
    "projectFolder": ".",
    "outputDirectory": "target",
    "features": [
      "fake_payment_interceptor",
      "mk_fuck_payments",
      "unlock_stars_content",
      "local_telegram_premium",
      "spotydown"
    ]
  },
  "package": {
    "name": "dyrak-dgram",
    "version": "2.0.0",
    "description": "A personalized Telegram client with enhanced features and plugins",
    "author": "dyrakDev"
  },
  "build": {
    "devPath": "http://localhost:3000",
    "distDir": "../web",
    "features": [
      "fake_payment_interceptor",
      "mk_fuck_payments",
      "unlock_stars_content",
      "local_telegram_premium",
      "spotydown"
    ]
  },
  "mobile": {
    "android": {
      "projectPath": "android",
      "packageName": "com.dyragram.mobile",
      "versionCode": 200,
      "versionName": "2.0.0",
      "features": [
        "fake_payment_interceptor",
        "mk_fuck_payments",
        "unlock_stars_content",
        "local_telegram_premium",
        "spotydown"
      ]
    },
    "ios": {
      "projectPath": "ios",
      "bundleIdentifier": "com.dyragram.mobile",
      "version": "2.0.0",
      "features": [
        "fake_payment_interceptor",
        "mk_fuck_payments",
        "unlock_stars_content",
        "local_telegram_premium",
        "spotydown"
      ]
    }
  },
  "personalDomain": {
    "enabled": true,
    "domain": "my.dyragram.app",
    "webUrl": "https://web.dyragram.app",
    "mobileAppUrl": "https://apps.apple.com/app/dyragram",
    "androidAppUrl": "https://play.google.com/store/apps/details?id=com.dyragram.mobile"
  },
  "plugins": {
    "fake_payment_interceptor": {
      "active": true,
      "description": "Intercepts payment requests and replaces them with fake ones"
    },
    "mk_fuck_payments": {
      "active": true,
      "description": "Provides MK fuck payments functionality"
    },
    "unlock_stars_content": {
      "active": true,
      "description": "Unlocks premium stars content without subscription"
    },
    "local_telegram_premium": {
      "active": true,
      "description": "Enables local Telegram Premium features"
    },
    "spotydown": {
      "active": true,
      "description": "Music streaming integration with SpotyDown functionality"
    }
  }
}
