{
  "$schema": "https://docs.tauri.app/project/config",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32.png",
      "icons/128.png",
      "icons/256.png",
      "icons/1024.png"
    ],
    "licenseFile": "LICENSE",
    "createUpdaterDir": true
  },
  "build": {
    "distDir": "../web",
    "devPath": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run start"
  },
  "plugins": {
    "spotydown": {
      "enabled": true,
      "config": {
        "outputFormat": "mp3",
        "bitrate": "320",
        "downloadPath": "~/Music/SpotyDown"
      }
    }
  },
  "updater": {
    "active": true,
    "pubKey": "YOUR_PUB_KEY_HERE",
    "endpoints": [
      "https://api.github.com/repos/dyrakdev/dyrakDGram/releases/latest"
    ]
  }
}
