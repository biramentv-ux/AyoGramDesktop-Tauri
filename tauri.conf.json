{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "./src-tauri/src-tauri-frontend/",
    "distDir": "../dist",
    "frontendDist": "../dist"
  },
  "package": {
    "productName": "AyoGramDesktop",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "AyoGram Team",
      "externalBins": [],
      "icon": [
        "icons/128x128.png",
        "icons/icon.ico",
        "icons/icon.icns"
      ],
      "identifier": "com.ayogram.desktop",
      "longDescription": "AyoGramDesktop хибрид - Qt/Telegram клиент с Ghost Mode и Stream Mode",
      "shortDescription": "Portable Telegram desktop клиент",
      "target": {
        "windows": {
          "fileExtension": "exe",
          "shortName": "AyoGramDesktop",
          "symbolicIcons": true
        }
      },
      "windows": {
        "certificateThumbprint": null,
        "nsis": {
          "allowElevation": false,
          "allowToChangeInstallMode": true,
          "createDesktopShortcut": true,
          "createStartMenuShortcut": true,
          "guid": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "installerChunkSize": 0,
          "installerName": "AyoGramDesktop_Installer_${arch}.${ext}",
          "menuCategory": "AyoGram",
          "perMachine": false,
          "requireAdministrator": false
        },
        "wix": {
          "shortName": "AyoGramDesktop"
        }
      }
    },
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://updates.ayogram.dev/releases/{{version}}"
      ],
      "pubkey": "YOUR_PUBLIC_KEY_HERE"
    },
    "security": {
      "csp": null,
      "freeze": false
    },
    "systemTray": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true
    },
    "window": {
      "center": true,
      "decorations": true,
      "fullscreen": false,
      "height": 800,
      "maxHeight": 1200,
      "maxWidth": 1400,
      "minHeight": 600,
      "minWidth": 900,
      "resizable": true,
      "title": "AyoGram Desktop",
      "visible": true,
      "width": 1000
    },
    "macOS": {
      "appCategoryType": "public.app-category.utilities",
      "minimumSystemVersion": "13.0"
    }
  }
}
