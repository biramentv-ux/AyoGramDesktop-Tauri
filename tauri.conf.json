{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "distDir": "dist",
    "devPath": "http://localhost:5173"
  },
  "package": {
    "productName": "AyoGramDesktop",
    "version": "1.0.0"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "AyoGram Desktop",
        "width": 1000,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "maxWidth": 1400,
        "maxHeight": 1200,
        "resizable": true,
        "center": true
      }
    ],
    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "identifier": "com.ayogram.desktop",
      "copyright": "AyoGram Team",
      "shortDescription": "Portable Telegram desktop client",
      "longDescription": "Telegram-inspired cross-platform desktop app built with Tauri v1 and Vite — portable Windows build.",
      "category": "Utility",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
    }
  }
}
