{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "distDir": "dist",
    "devPath": "http://localhost:5173"
  },
  "package": {
    "productName": "dyrakDGram",
    "version": "2.0.0"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "dyrakDGram",
        "width": 1000,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "maxWidth": 1400,
        "maxHeight": 1200,
        "resizable": true,
        "center": true
      }
    ],
    "bundle": {
      "active": true,
      "targets": ["nsis"],
      "identifier": "com.dyrak.dgram",
      "copyright": "dyrakDGram Team",
      "shortDescription": "Портативен Telegram клиент — български интерфейс",
      "longDescription": "dyrakDGram е портативен Windows Telegram клиент с български интерфейс, изграден върху оригинален Telegram. Portable build без инсталация.",
      "category": "Utility",
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
    }
  }
}
